{
  "$defs": {
    "Format": {
      "enum": [
        "mc",
        "exact",
        "extraction",
        "generation"
      ],
      "title": "Format",
      "type": "string"
    },
    "MatchBasis": {
      "enum": [
        "dcp_prevalence",
        "functional_analogue",
        "author_judgement"
      ],
      "title": "MatchBasis",
      "type": "string"
    },
    "Provenance": {
      "enum": [
        "human_written",
        "llm_drafted_human_verified"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "Register": {
      "enum": [
        "standard",
        "tussentaal",
        "dialect"
      ],
      "title": "Register",
      "type": "string"
    },
    "SecondReview": {
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "agrees_with_gold": {
          "title": "Agrees With Gold",
          "type": "boolean"
        },
        "context_gives_away_meaning": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Gives Away Meaning"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "answer",
        "agrees_with_gold"
      ],
      "title": "SecondReview",
      "type": "object"
    },
    "Split": {
      "enum": [
        "public",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "Track": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "H"
      ],
      "title": "Track",
      "type": "string"
    },
    "Variety": {
      "enum": [
        "be",
        "nl"
      ],
      "title": "Variety",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "pair_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pair Id"
    },
    "variety": {
      "$ref": "#/$defs/Variety"
    },
    "track": {
      "$ref": "#/$defs/Track"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "subcategory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subcategory"
    },
    "register": {
      "$ref": "#/$defs/Register",
      "default": "standard"
    },
    "marker": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Marker"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/Format"
    },
    "choices": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Choices"
    },
    "gold": {
      "title": "Gold",
      "type": "string"
    },
    "accepted_variants": {
      "items": {
        "type": "string"
      },
      "title": "Accepted Variants",
      "type": "array"
    },
    "scoring_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scoring Method"
    },
    "rubric": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rubric"
    },
    "difficulty": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Difficulty"
    },
    "match_basis": {
      "anyOf": [
        {
          "$ref": "#/$defs/MatchBasis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lexical_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lexical Source"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "licence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Licence"
    },
    "valid_as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid As Of"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "drafted_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drafted By"
    },
    "author": {
      "title": "Author",
      "type": "string"
    },
    "reviewed_by": {
      "items": {
        "type": "string"
      },
      "title": "Reviewed By",
      "type": "array"
    },
    "second_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/SecondReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "split": {
      "$ref": "#/$defs/Split",
      "default": "public"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "id",
    "variety",
    "track",
    "category",
    "prompt",
    "format",
    "gold",
    "provenance",
    "author"
  ],
  "title": "Item",
  "type": "object"
}
